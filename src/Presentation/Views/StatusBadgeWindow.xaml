<Window x:Class="WarframeRelicOverlay.Presentation.Views.StatusBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WarframeRelicOverlay Status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowActivated="False">
    <!-- Status badge shown at the top-centre of the Warframe client
         area while the overlay is tracking / detecting / pricing.
         Unlike OverlayWindow this window is NOT click-through, so the
         shutdown button beside the status text is actually clickable. -->
    <Border Background="#B312171F"
            BorderBrush="#CC7AE082"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,6">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="●"
                       FontSize="13"
                       Foreground="#7AE082"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#E7F7E9"
                       VerticalAlignment="Center" />

            <!-- Separator between the status text and the shutdown button -->
            <Border Width="1"
                    Margin="10,1,8,1"
                    Background="#442E3A31" />

            <!-- Shuts the whole overlay down.  The WM_NCHITTEST hook in
                 the code-behind makes this button the only part of the
                 window that swallows mouse input. -->
            <Button x:Name="ShutdownButton"
                    Content="✕"
                    FontSize="11"
                    FontWeight="Bold"
                    Padding="6,1"
                    Cursor="Hand"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    ToolTip="Shut down overlay"
                    Click="OnShutdownClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2C1C1C" />
                        <Setter Property="Foreground" Value="#CC6666" />
                        <Setter Property="BorderBrush" Value="#55CC6666" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#442020" />
                                <Setter Property="Foreground" Value="#FF6666" />
                                <Setter Property="BorderBrush" Value="#FF6666" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
