<Window x:Class="WarframeRelicOverlay.Presentation.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WarframeRelicOverlay.Presentation"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="WarframeRelicOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False"
        IsHitTestVisible="False"
        ShowActivated="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Inverse: true → Collapsed, false → Visible (for History tab hiding when Settings is active) -->
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!-- Inverse bool: true → false, false → true (for disabling slider when Auto is on) -->
        <local:InverseBooleanConverter x:Key="InverseBoolConverter" />

        <!-- Converts ARGB hex string to SolidColorBrush -->
        <local:StringToBrushConverter x:Key="StringToBrushConverter" />

        <Style x:Key="PriceLabelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#D0181410" />
            <Setter Property="BorderBrush" Value="#DDB08233" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="14,4,14,5" />
            <Setter Property="Opacity" Value="0.96" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="1" Opacity="0.55" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PriceTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F1DCA6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <!-- Absolute-positioned children are added at runtime.  The
             Canvas is sized to match the Warframe client area in DIPs;
             children are placed via Canvas.Left / Canvas.Top. -->
        <Canvas x:Name="LabelCanvas">
            <ItemsControl ItemsSource="{Binding PriceLabels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        <Setter Property="Width" Value="{Binding MaxWidth}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding BackgroundColor, Converter={StaticResource StringToBrushConverter}}" />
                                    <Setter Property="BorderBrush" Value="#DDB08233" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="5" />
                                    <Setter Property="Padding" Value="14,7,14,8" />
                                    <Setter Property="Opacity" Value="0.96" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.5" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFFFD46A" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FFD46A" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Best pick badge -->
                                <TextBlock Text="★ Best Pick"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#FFD46A"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,0,0,3"
                                           Visibility="{Binding IsHighlighted, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <!-- Item name (if available) -->
                                <TextBlock Text="{Binding ItemName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#E8E8E8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="200"
                                           Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemName}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Primary price -->
                                <TextBlock Text="{Binding Text}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F1DCA6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFE69D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="#888888" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUntradeable}" Value="True">
                                                    <Setter Property="Foreground" Value="#999999" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Detail row: Buy price (in Both mode) -->
                                <TextBlock Text="{Binding DetailText}"
                                           FontSize="11"
                                           Foreground="#A8A8A8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <!-- Top sell/buy prices (readable format with headers) -->
                                <TextBlock Text="{Binding TopPricesText}"
                                           FontSize="10"
                                           Foreground="#888888"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding HasTopPrices, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- Overlay active badge -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,14,0"
                Background="#B312171F"
                BorderBrush="#CC7AE082"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,6"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="●"
                           FontSize="13"
                           Foreground="#7AE082"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#E7F7E9"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Loading spinner overlaid above the reward area. Hidden by
             default; toggled by the view model. -->
        <Grid x:Name="SpinnerHost"
              Visibility="{Binding IsLoadingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border Background="#EB12161B"
                    BorderBrush="#CCB88A3E"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="SpinnerGlyph"
                               Text="◴"
                               FontSize="28"
                               Foreground="#FFF5E6B5"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Pricing..."
                               FontSize="11"
                               Foreground="#FFC7A155"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <!-- History / Settings panel — full-screen overlay. Toggled by
             the history hotkey. When visible, the window becomes
             interactive (click-through disabled). -->
        <Grid Visibility="{Binding IsHistoryPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#E6101418">

            <!-- Tab bar -->
            <Border VerticalAlignment="Top"
                    Background="#181C22"
                    BorderBrush="#33B08233"
                    BorderThickness="0,0,0,1"
                    Height="52">
                <Grid>
                    <!-- Tab buttons -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="24,0,0,0">
                        <!-- History tab -->
                        <Button Content="History"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="18,8"
                                Margin="0,0,2,0"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnHistoryTabClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="False">
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Settings tab -->
                        <Button Content="Settings"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="18,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnSettingsTabClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsTabActive}" Value="True">
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- Close hint -->
                    <TextBlock Text="Press hotkey or Escape to close"
                               FontSize="11"
                               Foreground="#555555"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                </Grid>
            </Border>

            <!-- ── History tab content ─────────────────────────── -->
            <ScrollViewer Margin="0,52,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSettingsTabActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock Text="No reward history yet. Complete a relic mission to start tracking."
                               FontSize="14"
                               Foreground="#555555"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HistoryRuns.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Historical price note -->
                    <TextBlock Text="Prices shown are from the time each reward was detected, not current market prices."
                               FontSize="11"
                               Foreground="#555555"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               TextAlignment="Center"
                               FontStyle="Italic" />

                    <!-- History runs as full-width rows with item chips -->
                    <ItemsControl ItemsSource="{Binding HistoryRuns}" Margin="24,12,24,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#15FFFFFF"
                                        BorderBrush="#22B08233"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Timestamp on left -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C7A155"
                                                   VerticalAlignment="Top"
                                                   Margin="0,2,20,0"
                                                   MinWidth="110" />
                                        <!-- Item chips flowing across remaining width -->
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,6"
                                                            CornerRadius="3"
                                                            Padding="10,5"
                                                            Background="#20FFFFFF"
                                                            BorderBrush="#33B08233"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   FontSize="13"
                                                                   TextWrapping="NoWrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#E8E8E8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Price}" Value="{x:Null}">
                                                                            <Setter Property="Foreground" Value="#777777"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Settings tab content ────────────────────────── -->
            <ScrollViewer Margin="0,52,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSettingsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="40,24,40,24" MaxWidth="560">

                    <!-- ═══ Price Display Mode ═══ -->
                    <TextBlock Text="Price Display"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F1DCA6"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Which price to show on the overlay card"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,10" />
                    <!-- Segmented toggle: Sell / Buy / Both -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <Button Content="Sell"
                                Command="{Binding SetPriceDisplayCommand}"
                                CommandParameter="Sell"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="20,8" Margin="0,0,2,0"
                                Cursor="Hand" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2028"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#33B08233"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PriceDisplay}" Value="Sell">
                                            <Setter Property="Background" Value="#44B08233"/>
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Buy"
                                Command="{Binding SetPriceDisplayCommand}"
                                CommandParameter="Buy"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="20,8" Margin="0,0,2,0"
                                Cursor="Hand" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2028"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#33B08233"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PriceDisplay}" Value="Buy">
                                            <Setter Property="Background" Value="#44B08233"/>
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Both"
                                Command="{Binding SetPriceDisplayCommand}"
                                CommandParameter="Both"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="20,8"
                                Cursor="Hand" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2028"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#33B08233"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PriceDisplay}" Value="Both">
                                            <Setter Property="Background" Value="#44B08233"/>
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- ═══ Seller Prices Count ═══ -->
                    <TextBlock Text="Seller Prices Shown"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F1DCA6"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Show the lowest 1 or lowest 5 seller prices per item on the reward screen"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <Button Content="Top 1"
                                Command="{Binding SetShowTopPricesCommand}"
                                CommandParameter="1"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="20,8" Margin="0,0,2,0"
                                Cursor="Hand" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2028"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#33B08233"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTopPrices}" Value="1">
                                            <Setter Property="Background" Value="#44B08233"/>
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Top 5"
                                Command="{Binding SetShowTopPricesCommand}"
                                CommandParameter="5"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="20,8"
                                Cursor="Hand" BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2028"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#33B08233"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTopPrices}" Value="5">
                                            <Setter Property="Background" Value="#44B08233"/>
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- ═══ Card Background Colour ═══ -->
                    <TextBlock Text="Card Background Color"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F1DCA6"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Click a preset or enter a custom ARGB hex value"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,10" />
                    <!-- Swatch row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Swatch 0: Dark Charcoal -->
                        <Button Command="{Binding SelectSwatchCommand}" CommandParameter="0"
                                Cursor="Hand" Margin="0,0,8,0" Padding="0"
                                BorderThickness="0" Background="Transparent">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="#EE181410"
                                    ToolTip="Dark Charcoal (#EE181410)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#33B08233"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSwatchIndex}" Value="0">
                                                <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Button>
                        <!-- Swatch 1: Transparent -->
                        <Button Command="{Binding SelectSwatchCommand}" CommandParameter="1"
                                Cursor="Hand" Margin="0,0,8,0" Padding="0"
                                BorderThickness="0" Background="Transparent">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="#80181410"
                                    ToolTip="Transparent (#80181410)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#33B08233"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSwatchIndex}" Value="1">
                                                <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Button>
                        <!-- Swatch 2: Warm Brown -->
                        <Button Command="{Binding SelectSwatchCommand}" CommandParameter="2"
                                Cursor="Hand" Margin="0,0,8,0" Padding="0"
                                BorderThickness="0" Background="Transparent">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="#EE2A2015"
                                    ToolTip="Warm Brown (#EE2A2015)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#33B08233"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSwatchIndex}" Value="2">
                                                <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Button>
                        <!-- Swatch 3: Deep Blue -->
                        <Button Command="{Binding SelectSwatchCommand}" CommandParameter="3"
                                Cursor="Hand" Margin="0,0,8,0" Padding="0"
                                BorderThickness="0" Background="Transparent">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="#EE101828"
                                    ToolTip="Deep Blue (#EE101828)">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#33B08233"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSwatchIndex}" Value="3">
                                                <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Button>
                    </StackPanel>
                    <!-- Current colour preview (clearly separated from swatches) -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBlock Text="Preview:"
                                   FontSize="12"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Border Width="120" Height="32" CornerRadius="4"
                                Background="{Binding CardBackgroundColor, Converter={StaticResource StringToBrushConverter}}"
                                BorderBrush="#55FFFFFF" BorderThickness="1"
                                Padding="10,4">
                            <TextBlock Text="45◆"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F1DCA6"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <!-- Hex override TextBox -->
                    <TextBox Text="{Binding CardBackgroundColor, UpdateSourceTrigger=LostFocus}"
                             FontSize="13"
                             Foreground="#E8E8E8"
                             Background="#1C2028"
                             BorderBrush="#44B08233"
                             BorderThickness="1"
                             Padding="10,6"
                             MaxWidth="200"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,28" />

                    <!-- ═══ Panel Hotkey ═══ -->
                    <TextBlock Text="Panel Hotkey"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F1DCA6"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Key combo that opens/closes this panel"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,10" />
                    <!-- Current hotkey display + record button -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1C2028"
                                BorderBrush="#44B08233"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12,6"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding HotkeyDisplayText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E8E8E8" />
                        </Border>
                        <Button Command="{Binding StartHotkeyListeningCommand}"
                                FontSize="12"
                                Padding="14,6"
                                Cursor="Hand"
                                BorderThickness="1">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2028"/>
                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                    <Setter Property="BorderBrush" Value="#44B08233"/>
                                    <Setter Property="Content" Value="Press keys…"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHotkeyListening}" Value="True">
                                            <Setter Property="Content" Value="Listening…"/>
                                            <Setter Property="BorderBrush" Value="#F1DCA6"/>
                                            <Setter Property="Foreground" Value="#F1DCA6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- Fallback manual TextBox -->
                    <TextBox Text="{Binding HistoryHotkey, UpdateSourceTrigger=LostFocus}"
                             FontSize="12"
                             Foreground="#888888"
                             Background="#1C2028"
                             BorderBrush="#33B08233"
                             BorderThickness="1"
                             Padding="8,4"
                             MaxWidth="200"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,4" />
                    <TextBlock Text="Advanced: type hotkey manually (e.g. Ctrl+H)"
                               FontSize="11"
                               Foreground="#555555"
                               Margin="0,0,0,28" />

                    <!-- ═══ Overlay Opacity ═══ -->
                    <TextBlock Text="Overlay Opacity"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F1DCA6"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Adjust how transparent the price cards appear"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0.5" Maximum="1.0"
                                Value="{Binding OverlayOpacity}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding OpacityPercentLabel}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E8E8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <!-- Live preview -->
                        <Border Grid.Column="2"
                                Background="#EE181410"
                                BorderBrush="#DDB08233"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,3"
                                Opacity="{Binding OverlayOpacity}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="45◆"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F1DCA6" />
                        </Border>
                    </Grid>

                    <!-- ═══ Font Size ═══ -->
                    <TextBlock Text="Price Font Size"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F1DCA6"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Size of the platinum price text on overlay cards"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,10" />
                    <!-- Auto checkbox -->
                    <CheckBox IsChecked="{Binding IsAutoFontSize}"
                              Margin="0,0,0,8"
                              Cursor="Hand">
                        <TextBlock Text="Auto (scale with window size)"
                                   FontSize="12"
                                   Foreground="#AAAAAA" />
                    </CheckBox>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="12" Maximum="32"
                                Value="{Binding PriceFontSize}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsAutoFontSize, Converter={StaticResource InverseBoolConverter}}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FontSizeLabel}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E8E8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <!-- Sample text preview -->
                    <Border Background="#EE181410"
                            BorderBrush="#DDB08233"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,6"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,28">
                        <TextBlock Text="Nikana Prime Blade · 45◆"
                                   FontSize="{Binding PreviewFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="#F1DCA6" />
                    </Border>

                    <!-- Save note -->
                    <TextBlock Text="Settings are saved automatically to data/settings.json."
                               FontSize="12"
                               Foreground="#555555" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
